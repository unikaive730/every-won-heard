# Copy to .env for local runs. On Render these are set in render.yaml / the dashboard instead.

# --- AssemblyAI (required for live voice) ---
# Get a key at https://www.assemblyai.com/dashboard
# The key stays on the server. The browser only ever receives a short-lived temporary token.
ASSEMBLYAI_API_KEY=

# --- Voice Agent API (English calls) ---
# Stored agent created by `npm run agent:compile` (prints the id). Leave empty to connect with inline settings.
VOICE_AGENT_ID=
# stored (bind VOICE_AGENT_ID, then swap tools per stage with session.update) | inline (send the whole config)
VA_CONNECT=stored
# Max length of one Voice Agent call in seconds (the token's max_session_duration_seconds)
VA_MAX_SESSION_SECONDS=240

# --- Korean streaming (Universal-3.6 Pro) ---
# Max length of one Korean streaming session in seconds (a consultation takes about 4 minutes)
KO_MAX_SESSION_SECONDS=300

# --- Public demo ---
# 1 on the public deployment: only the allowlisted products (server/data/display-names.json) under generic
# names, checkout opens a demo page ("Demo checkout. No payment is taken."), place search is off, uploads are
# capped, and the call limits below are on. Leave 0 on your own machine.
DEMO_MODE=0
# Voice calls per day for everyone together (a token is a call). Per IP: 3 a minute, 10 a day.
DAILY_SESSION_CAP=25
# 0 pauses every voice route at once (typing keeps working): "The voice demo is paused."
VOICE_DEMO_ENABLED=1
# Limits follow DEMO_MODE. 1 forces them on, 0 forces them off.
# VOICE_GUARD=
# Proxies in front of the server that append X-Forwarded-For (1 on Render). 0 = use the socket address.
TRUST_PROXY_HOPS=0
# Base URL for links the server hands out (demo checkout). Empty = the request's own host.
PUBLIC_BASE_URL=

# --- Post-call summary (AssemblyAI LLM Gateway, same AssemblyAI key) ---
# Off by default: the receipt uses a template filled from the ledger. 1 = ask the model for the prose
# (it may only write placeholders; the server fills every number from the ledger).
CALL_SUMMARY=0
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# --- MarketPilot public MCP (optional) ---
# Public endpoint, no auth needed for product catalog / checkout link.
# If unreachable, the server falls back to server/data/products.mock.json (the demo allowlist) and says so in /api/health.
MARKETPILOT_MCP_URL=https://api.marketpilot.it/mcp

# --- Text-mode LLM (optional, not used by the public demo) ---
# Anthropic key used ONLY by this project (never a production key). Empty = the built-in rule engine.
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# --- Server ---
PORT=8787
