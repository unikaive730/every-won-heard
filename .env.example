# --- AssemblyAI (required for live voice) ---
# Get a key at https://www.assemblyai.com/dashboard  (free tier includes streaming hours)
# The key stays on the server. The browser only ever receives a short-lived temporary token.
ASSEMBLYAI_API_KEY=

# --- LLM (optional) ---
# Anthropic API key used ONLY by this project (do not reuse the production MarketPilot key).
# If empty, the agent runs on the built-in rule engine (slot filling + channel-mix rules).
LLM_API_KEY=
# Optional model override (default: claude-opus-5)
LLM_MODEL=claude-opus-5

# --- MarketPilot public MCP (optional) ---
# Public endpoint, no auth needed for product catalog / place search / checkout link.
# If unreachable, the server falls back to server/data/products.mock.json and says so in /api/health.
MARKETPILOT_MCP_URL=https://api.marketpilot.it/mcp

# --- Server ---
PORT=8787
