# --- AssemblyAI (required for live voice) ---
# Get a key at https://www.assemblyai.com/dashboard  (free tier includes streaming hours)
# The key stays on the server. The browser only ever receives a short-lived temporary token.
ASSEMBLYAI_API_KEY=

# --- LLM (optional) ---
# Anthropic API key used ONLY by this project (do not reuse the production MarketPilot key).
# If empty, the agent runs on the built-in rule engine (slot filling + channel-mix rules).
LLM_API_KEY=
# Optional model override (default: claude-opus-5)
LLM_MODEL=claude-opus-5

# --- MarketPilot public MCP (optional) ---
# Public endpoint, no auth needed for product catalog / place search / checkout link.
# If unreachable, the server falls back to server/data/products.mock.json and says so in /api/health.
MARKETPILOT_MCP_URL=https://api.marketpilot.it/mcp

# --- Server ---
PORT=8787

# --- Korean streaming (Universal-3.6 Pro) ---
# Max length of one Korean streaming session in seconds (a consultation takes about 4 minutes)
KO_MAX_SESSION_SECONDS=300

# --- Post-call summary (AssemblyAI LLM Gateway, same AssemblyAI key) ---
# Off by default: the receipt uses a template filled from the ledger. 1 = ask the model for the prose
# (it may only write placeholders; the server fills every number from the ledger).
CALL_SUMMARY=0
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# --- Voice Agent API (English path) ---
# Stored agent made by `npm run agent:compile` (scripts/compile-agent.mjs). Empty = connect with the inline config.
VOICE_AGENT_ID=
# stored (bind VOICE_AGENT_ID, then swap tools per stage with session.update) | inline (send the whole config)
VA_CONNECT=stored
# Max length of one Voice Agent session in seconds (the token caps it; $4.50/hour at list price)
VA_MAX_SESSION_SECONDS=240
# 1 = the checkout tool returns a demo page link and no payment is taken
DEMO_MODE=0
# Public origin for links the agent hands out (defaults to the request's host)
PUBLIC_BASE_URL=
