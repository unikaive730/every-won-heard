{
  "name": "marketpilot-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Voice marketing consultant for small business owners - AssemblyAI Universal-Streaming + LLM agent + MarketPilot MCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "agent:compile": "node scripts/compile-agent.mjs",
    "va:harness": "node scripts/va-harness.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "license": "MIT"
}
