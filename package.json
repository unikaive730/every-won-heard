{
  "name": "marketpilot-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Every Won Heard: a voice marketing consultant for small shop owners on the AssemblyAI Voice Agent API and Universal-3.6 Pro streaming, where every amount traces back to the owner's words or the catalog",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "license": "MIT"
}
